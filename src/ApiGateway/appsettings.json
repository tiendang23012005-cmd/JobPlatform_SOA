{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [
      "http://localhost:5100"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/v1/users/{**rest}"
        }
      },
      "job-jobs": {
        "ClusterId": "job",
        "Match": {
          "Path": "/api/v1/jobs/{**rest}"
        }
      },
      "job-applications": {
        "ClusterId": "job",
        "Match": {
          "Path": "/api/v1/applications/{**rest}"
        }
      },
      "contract-contracts": {
        "ClusterId": "contract",
        "Match": {
          "Path": "/api/v1/contracts/{**rest}"
        }
      },
      "contract-milestones": {
        "ClusterId": "contract",
        "Match": {
          "Path": "/api/v1/milestones/{**rest}"
        }
      },
      "contract-disputes": {
        "ClusterId": "contract",
        "Match": {
          "Path": "/api/v1/disputes/{**rest}"
        }
      },
      "payment-wallet": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/v1/wallet/{**rest}"
        }
      },
      "payment-escrow": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/v1/escrow/{**rest}"
        }
      },
      "notification-notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/v1/notifications/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "job": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://job-api:8080/"
          }
        }
      },
      "contract": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://contract-api:8080/"
          }
        }
      },
      "payment": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://payment-api:8080/"
          }
        }
      },
      "notification": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "d1": {
            "Address": "http://notification-api:8080/"
          }
        }
      }
    }
  }
}
