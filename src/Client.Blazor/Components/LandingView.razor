<section class="jp-landing-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="jp-chip mb-3"><i class="bi bi-stars"></i> Nền tảng việc làm bán thời gian và tự do</span>
                <h1>Làm việc linh hoạt, <span>thanh toán an toàn</span></h1>
                <p class="lead">Freelancer tìm được dự án phù hợp, nhà tuyển dụng tìm được nhân sự đáng tin cậy. Hợp đồng minh bạch, tiền được ký quỹ và giải ngân theo từng cột mốc.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary btn-lg" href="register">Bắt đầu miễn phí <i class="bi bi-arrow-right ms-1"></i></a>
                    <a class="btn btn-light-blue btn-lg" href="login">Tôi đã có tài khoản</a>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="jp-mock">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <b>Hợp đồng đang thực hiện</b><span class="jp-chip ok">Đã ký quỹ</span>
                    </div>
                    <div class="row-i"><span class="jp-avatar">TK</span><div class="flex-grow-1"><b>Thiết kế giao diện ứng dụng</b><br /><small class="text-muted">Cột mốc 1 · Đã nghiệm thu</small></div><i class="bi bi-check-circle-fill text-success fs-5"></i></div>
                    <div class="row-i"><span class="jp-avatar">LT</span><div class="flex-grow-1"><b>Lập trình trang quản trị</b><br /><small class="text-muted">Cột mốc 2 · Đang thực hiện</small></div><i class="bi bi-hourglass-split text-primary fs-5"></i></div>
                    <div class="row-i mb-0"><span class="jp-avatar">KT</span><div class="flex-grow-1"><b>Kiểm thử và bàn giao</b><br /><small class="text-muted">Cột mốc 3 · Chờ bắt đầu</small></div><i class="bi bi-clock text-secondary fs-5"></i></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="jp-section" id="features">
    <div class="container">
        <div class="text-center mb-5">
            <h2>Mọi thứ bạn cần để hợp tác an tâm</h2>
            <p class="text-muted">Quy trình khép kín từ đăng tin đến thanh toán.</p>
        </div>
        <div class="row g-4">
            @foreach (var f in features)
            {
                <div class="col-md-6 col-lg-4"><div class="jp-feature"><div class="ico"><i class="bi @f.Icon"></i></div><h5 class="fw-bold">@f.Title</h5><p class="text-muted mb-0">@f.Desc</p></div></div>
            }
        </div>
    </div>
</section>

<section class="jp-section" id="how">
    <div class="container">
        <div class="text-center mb-4"><h2>Cách hoạt động</h2></div>
        <div class="row">
            <div class="col-md-4"><div class="jp-step"><div class="num">1</div><h5 class="fw-bold">Tạo tài khoản</h5><p class="text-muted">Đăng ký, xác minh email và chọn vai trò Freelancer hoặc Nhà tuyển dụng.</p></div></div>
            <div class="col-md-4"><div class="jp-step"><div class="num">2</div><h5 class="fw-bold">Kết nối và ký hợp đồng</h5><p class="text-muted">Nhà tuyển dụng đăng tin, Freelancer ứng tuyển, hai bên thống nhất hợp đồng.</p></div></div>
            <div class="col-md-4"><div class="jp-step"><div class="num">3</div><h5 class="fw-bold">Làm việc và nhận thanh toán</h5><p class="text-muted">Nghiệm thu từng cột mốc, tiền ký quỹ được giải ngân an toàn.</p></div></div>
        </div>
    </div>
</section>

<section class="jp-section">
    <div class="container">
        <div class="jp-cta">
            <h2 class="fw-bold text-white">Sẵn sàng bắt đầu?</h2>
            <p class="mb-4" style="color:#dbe8ff">Tạo tài khoản trong chưa đầy một phút.</p>
            <a class="btn btn-light btn-lg text-primary" href="register">Đăng ký ngay</a>
        </div>
    </div>
</section>

@code {
    private record Feature(string Icon, string Title, string Desc);

    private static readonly Feature[] features =
    {
        new("bi-file-earmark-check", "Hợp đồng rõ ràng", "Phạm vi, đầu ra, thời hạn và tiêu chí nghiệm thu được ghi rõ, hai bên xác nhận cùng một phiên bản."),
        new("bi-shield-lock", "Ký quỹ an toàn", "Tiền được giữ trong ký quỹ và chỉ giải ngân khi nghiệm thu, bảo vệ cả hai bên."),
        new("bi-flag", "Nghiệm thu theo cột mốc", "Chia dự án thành các cột mốc, thanh toán tương ứng với từng phần việc hoàn thành."),
        new("bi-bell", "Thông báo tức thì", "Nhận thông báo cho mọi sự kiện quan trọng như xác minh, ký hợp đồng, giải ngân."),
        new("bi-person-check", "Xác minh tài khoản", "Email được xác minh bằng mã OTP, phân quyền rõ ràng theo từng vai trò."),
        new("bi-diagram-3", "Kiến trúc hướng dịch vụ", "Các dịch vụ độc lập, giao tiếp bất đồng bộ, dễ mở rộng và tự phục hồi khi có sự cố."),
    };
}
