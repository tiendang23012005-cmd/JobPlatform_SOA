@page "/login"
@layout AuthLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Đăng nhập · JobPlatform</PageTitle>

<h1>Chào mừng trở lại</h1>
<p class="text-muted mb-4">Đăng nhập để tiếp tục sử dụng JobPlatform.</p>

@if (Verified) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>Xác minh email thành công. Mời bạn đăng nhập.</div> }

<EditForm Model="model" OnValidSubmit="Submit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" placeholder="ban@example.com" @bind-Value="model.Email" />
        <ValidationMessage For="() => model.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <div class="input-group">
            <InputText type="@(show ? "text" : "password")" class="form-control" placeholder="Nhập mật khẩu" @bind-Value="model.Password" />
            <button type="button" class="btn btn-eye" @onclick="() => show = !show"><i class="bi @(show ? "bi-eye-slash" : "bi-eye")"></i></button>
        </div>
        <ValidationMessage For="() => model.Password" />
    </div>
    @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2"><i class="bi bi-exclamation-circle me-2"></i>@error</div> }
    <button class="btn btn-primary w-100 btn-lg" disabled="@busy">
        @if (busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
        Đăng nhập
    </button>
</EditForm>

<div class="text-center mt-4 text-muted">
    Chưa có tài khoản? <a href="register" class="fw-semibold">Đăng ký</a><br />
    <a href="verify" class="small">Chưa xác minh email? Nhập mã OTP</a>
</div>

@code {
    [SupplyParameterFromQuery] public bool Verified { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginRequest model = new();
    private string? error;
    private bool busy, show;

    private async Task Submit()
    {
        busy = true; error = null;
        var (ok, message) = await Auth.LoginAsync(model);
        busy = false;
        if (!ok) { error = message; return; }

        var target = !string.IsNullOrEmpty(ReturnUrl) && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains(':') ? ReturnUrl : "";
        Nav.NavigateTo(target);
    }
}
