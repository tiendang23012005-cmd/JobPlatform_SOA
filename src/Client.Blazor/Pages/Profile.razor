@page "/profile"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Hồ sơ · JobPlatform</PageTitle>
<div class="jp-page-head"><h1>Hồ sơ của tôi</h1><p>Thông tin tài khoản của bạn.</p></div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (me is null)
{
    <p class="text-muted">Đang tải...</p>
}
else
{
    <div class="card" style="max-width:760px">
        <div class="jp-profile-cover"></div>
        <div class="jp-profile-body">
            <div class="d-flex align-items-end gap-3 flex-wrap">
                <div class="jp-avatar lg">@Ui.Initials(me.FullName)</div>
                <div class="pb-2">
                    <h4 class="fw-bold mb-1">@me.FullName</h4>
                    <span class="jp-chip @(me.Role == "Admin" ? "admin" : "")"><i class="bi bi-person-badge"></i> @Ui.RoleLabel(me.Role)</span>
                    <span class="jp-chip ok ms-1"><i class="bi bi-patch-check-fill"></i> @StatusLabel(me.Status)</span>
                </div>
            </div>
            <div class="mt-4">
                <div class="jp-kv"><span>Họ và tên</span><b>@me.FullName</b></div>
                <div class="jp-kv"><span>Email</span><b>@me.Email</b></div>
                <div class="jp-kv"><span>Vai trò</span><b>@Ui.RoleLabel(me.Role)</b></div>
                <div class="jp-kv"><span>Mã tài khoản</span><b class="small">@me.Id</b></div>
            </div>
        </div>
    </div>
}

@code {
    private record Me(Guid Id, string Email, string Role, string Status, string? FullName);

    private Me? me;
    private string? error;

    private static string StatusLabel(string s) => s switch { "Active" => "Đã xác minh", "Locked" => "Đã khóa", _ => s };

    protected override async Task OnInitializedAsync()
    {
        try { me = await Http.GetFromJsonAsync<Me>("api/v1/users/me"); }
        catch (Exception ex) { error = "Không tải được hồ sơ: " + ex.Message; }
    }
}
