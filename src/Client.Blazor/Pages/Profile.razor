@page "/profile"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Hồ sơ · JobPlatform</PageTitle>
<div class="jp-page-head">
    <h1>Hồ sơ của tôi</h1>
    <p>Quản lý thông tin cá nhân và bảo mật tài khoản.</p>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success">@message</div>
}
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
@if (loading)
{
    <p class="text-muted">Đang tải hồ sơ...</p>
}
else if (profile is not null)
{
    <div class="row g-4">
        <div class="col-12 col-xl-7">
            <div class="card h-100">
                <div class="card-header bg-white py-3"><h5 class="mb-0 fw-bold">Thông tin cá nhân</h5></div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="jp-avatar lg">@Ui.Initials(profile.FullName)</div>
                        <div><h5 class="mb-1">@profile.FullName</h5><div class="text-muted small">@profile.Email · @Ui.RoleLabel(profile.Role)</div></div>
                    </div>
                    <EditForm Model="profile" OnValidSubmit="SaveProfile">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small" />
                        <div class="mb-3"><label class="form-label">Họ và tên</label><InputText class="form-control" @bind-Value="profile.FullName" /></div>
                        <div class="mb-3"><label class="form-label">Email</label><input class="form-control" value="@profile.Email" disabled /></div>
                        <div class="mb-3"><label class="form-label">Số điện thoại</label><InputText class="form-control" @bind-Value="profile.Phone" /></div>
                        <div class="mb-3"><label class="form-label">Kỹ năng</label><InputTextArea class="form-control" rows="3" @bind-Value="profile.Skills" placeholder="Ví dụ: C#, ASP.NET Core, SQL Server..." /></div>
                        <div class="mb-3"><label class="form-label">Giới thiệu bản thân</label><InputTextArea class="form-control" rows="4" @bind-Value="profile.Bio" /></div>
                        <button class="btn btn-primary" type="submit" disabled="@savingProfile"><i class="bi bi-save me-1"></i>@(savingProfile ? "Đang lưu..." : "Lưu thay đổi")</button>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="col-12 col-xl-5">
            <div class="card">
                <div class="card-header bg-white py-3"><h5 class="mb-0 fw-bold">Đổi mật khẩu</h5></div>
                <div class="card-body">
                    <EditForm Model="password" OnValidSubmit="ChangePassword">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger small" />
                        <div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label><InputText class="form-control" type="password" @bind-Value="password.CurrentPassword" /></div>
                        <div class="mb-3"><label class="form-label">Mật khẩu mới</label><InputText class="form-control" type="password" @bind-Value="password.NewPassword" /></div>
                        <div class="mb-3"><label class="form-label">Xác nhận mật khẩu mới</label><InputText class="form-control" type="password" @bind-Value="password.ConfirmPassword" /></div>
                        <p class="text-muted small">Mật khẩu mới tối thiểu 8 ký tự, gồm chữ, số và ký tự đặc biệt.</p>
                        <button class="btn btn-outline-primary" type="submit" disabled="@savingPassword">@(savingPassword ? "Đang cập nhật..." : "Đổi mật khẩu")</button>
                    </EditForm>
                </div>
            </div>
            <div class="card mt-4"><div class="card-body">
                <div class="small text-muted mb-1">Trạng thái tài khoản</div>
                <span class="jp-chip @(profile.Status == "Active" ? "ok" : "")">@StatusLabel(profile.Status)</span>
                <div class="small text-muted mt-3">Mã tài khoản</div><code class="small">@profile.Id</code>
            </div></div>
        </div>
    </div>
}

@code {
    private ProfileModel? profile;
    private readonly PasswordModel password = new();
    private bool loading = true, savingProfile, savingPassword;
    private string? message, error;

    private static string StatusLabel(string status) => status switch
    {
        "Active" => "Đang hoạt động", "Locked" => "Đã khóa", "PendingVerification" => "Chờ xác minh", _ => status
    };

    protected override async Task OnInitializedAsync()
    {
        try { profile = await Http.GetFromJsonAsync<ProfileModel>("api/v1/users/me"); }
        catch (Exception ex) { error = "Không tải được hồ sơ: " + ex.Message; }
        finally { loading = false; }
    }

    private async Task SaveProfile()
    {
        if (profile is null) return;
        savingProfile = true; message = error = null;
        try
        {
            var response = await Http.PutAsJsonAsync("api/v1/users/me", new { profile.FullName, profile.Phone, profile.Skills, profile.Bio });
            if (!response.IsSuccessStatusCode) { error = await AuthService.ReadError(response); return; }
            message = "Cập nhật hồ sơ thành công.";
        }
        catch (HttpRequestException) { error = "Không kết nối được máy chủ."; }
        finally { savingProfile = false; }
    }

    private async Task ChangePassword()
    {
        message = error = null;
        if (password.NewPassword != password.ConfirmPassword) { error = "Mật khẩu xác nhận không khớp."; return; }
        savingPassword = true;
        try
        {
            var response = await Http.PutAsJsonAsync("api/v1/users/me/password", new { password.CurrentPassword, password.NewPassword });
            if (!response.IsSuccessStatusCode) { error = await AuthService.ReadError(response); return; }
            message = "Đổi mật khẩu thành công.";
            password.CurrentPassword = password.NewPassword = password.ConfirmPassword = "";
        }
        catch (HttpRequestException) { error = "Không kết nối được máy chủ."; }
        finally { savingPassword = false; }
    }

    private sealed class ProfileModel
    {
        public Guid Id { get; set; }
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string Status { get; set; } = "";
        public string FullName { get; set; } = "";
        public string? Phone { get; set; }
        public string? Skills { get; set; }
        public string? Bio { get; set; }
    }

    private sealed class PasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vui lòng nhập mật khẩu hiện tại.")]
        public string CurrentPassword { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vui lòng nhập mật khẩu mới.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Mật khẩu mới phải có ít nhất 8 ký tự.")]
        public string NewPassword { get; set; } = "";
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vui lòng xác nhận mật khẩu mới.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
