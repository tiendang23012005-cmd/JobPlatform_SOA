@page "/don-ung-tuyen"

@using Microsoft.AspNetCore.Authorization
@using Client.Blazor.Services

@attribute [Authorize(Roles = "Freelancer")]

@inject JobApiService JobApi
@inject NavigationManager Nav

<PageTitle>Đơn ứng tuyển · JobPlatform</PageTitle>

<div class="d-flex justify-content-between
            align-items-center flex-wrap gap-3 mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Đơn ứng tuyển của tôi
        </h2>

        <p class="text-muted mb-0">
            Theo dõi tiến độ và kết quả các đơn ứng tuyển đã gửi.
        </p>

    </div>

    <button class="btn btn-primary"
            @onclick="GoToFindJobs">

        <i class="bi bi-search me-2"></i>
        Tìm việc mới

    </button>

</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<!-- THỐNG KÊ ĐƠN ỨNG TUYỂN -->

<div class="row g-3 mb-4">

    <div class="col-md-3 col-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <i class="bi bi-file-earmark-text
                          fs-3 text-primary"></i>

                <div class="text-muted mt-2">
                    Tổng số đơn
                </div>

                <h3 class="fw-bold text-primary mb-0">
                    @applications.Count
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3 col-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <i class="bi bi-hourglass-split
                          fs-3 text-warning"></i>

                <div class="text-muted mt-2">
                    Chờ xử lý
                </div>

                <h3 class="fw-bold text-warning mb-0">
                    @applications.Count(x => x.Status == "Pending")
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3 col-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <i class="bi bi-check-circle
                          fs-3 text-success"></i>

                <div class="text-muted mt-2">
                    Đã chấp nhận
                </div>

                <h3 class="fw-bold text-success mb-0">
                    @applications.Count(x => x.Status == "Accepted")
                </h3>

            </div>

        </div>

    </div>

    <div class="col-md-3 col-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">

                <i class="bi bi-x-circle
                          fs-3 text-danger"></i>

                <div class="text-muted mt-2">
                    Đã từ chối
                </div>

                <h3 class="fw-bold text-danger mb-0">
                    @applications.Count(x => x.Status == "Rejected")
                </h3>

            </div>

        </div>

    </div>

</div>

<!-- BỘ LỌC -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-6">

                <label class="form-label">
                    Tìm kiếm công việc
                </label>

                <input class="form-control"
                       placeholder="Nhập tên công việc..."
                       @bind="keyword"
                       @bind:event="oninput" />

            </div>

            <div class="col-md-4">

                <label class="form-label">
                    Trạng thái đơn
                </label>

                <select class="form-select"
                        @bind="statusFilter">

                    <option value="">
                        Tất cả trạng thái
                    </option>

                    <option value="Pending">
                        Chờ xử lý
                    </option>

                    <option value="Accepted">
                        Đã chấp nhận
                    </option>

                    <option value="Rejected">
                        Đã từ chối
                    </option>

                </select>

            </div>

            <div class="col-md-2 d-flex align-items-end">

                <button class="btn btn-outline-primary w-100"
                        disabled="@loading"
                        @onclick="LoadAsync">

                    <i class="bi bi-arrow-clockwise"></i>
                    Làm mới

                </button>

            </div>

        </div>

    </div>

</div>

<!-- DANH SÁCH ĐƠN ỨNG TUYỂN -->

<div class="card shadow-sm">

    <div class="card-header bg-white py-3">

        <h5 class="fw-bold mb-0">
            Danh sách đơn ứng tuyển
        </h5>

    </div>

    <div class="card-body">

        @if (loading)
        {
            <div class="text-center py-5">

                <div class="spinner-border text-primary"></div>

                <p class="text-muted mt-2">
                    Đang tải danh sách đơn...
                </p>

            </div>
        }
        else if (!FilteredApplications.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-inbox fs-1 text-muted"></i>

                <h5 class="mt-3">
                    Không có đơn ứng tuyển phù hợp
                </h5>

                <p class="text-muted">
                    Bạn có thể tìm kiếm thêm công việc mới.
                </p>

                <button class="btn btn-primary"
                        @onclick="GoToFindJobs">

                    Tìm việc ngay

                </button>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Công việc</th>

                            <th>Ngân sách đề xuất</th>

                            <th>Trạng thái</th>

                            <th>Ngày ứng tuyển</th>

                            <th>Thao tác</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var application in FilteredApplications)
                        {
                            <tr @key="application.Id">

                                <td style="min-width:220px">

                                    <div class="fw-semibold text-primary">
                                        @application.JobTitle
                                    </div>

                                    @if (application.Status == "Rejected" &&
                                        !string.IsNullOrWhiteSpace(
                                            application.RejectionReason))
                                    {
                                        <div class="small text-danger mt-1">

                                            Lý do:

                                            @application.RejectionReason

                                        </div>
                                    }

                                </td>

                                <td class="fw-semibold text-success">

                                    @JobUi.Money(application.ProposedBudget)

                                </td>

                                <td>

                                    <span class="badge @JobUi.StatusClass(application.Status)">

                                        @JobUi.StatusLabel(application.Status)

                                    </span>

                                </td>

                                <td>

                                    @application.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")

                                </td>

                                <td>

                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => ShowDetails(application)">

                                        <i class="bi bi-eye me-1"></i>
                                        Chi tiết

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<!-- CHI TIẾT ĐƠN ỨNG TUYỂN -->

@if (selectedApplication is not null)
{
    <div class="card shadow-sm mt-4">

        <div class="card-header bg-white d-flex
                    justify-content-between align-items-center">

            <h5 class="fw-bold mb-0">
                Chi tiết đơn ứng tuyển
            </h5>

            <button class="btn-close"
                    @onclick="CloseDetails">
            </button>

        </div>

        <div class="card-body p-4">

            <h4 class="text-primary">
                @selectedApplication.JobTitle
            </h4>

            <span class="badge @JobUi.StatusClass(selectedApplication.Status)">

                @JobUi.StatusLabel(selectedApplication.Status)

            </span>

            <div class="mt-4">

                <h6 class="fw-bold">
                    Thư ứng tuyển
                </h6>

                <p style="white-space:pre-wrap">

                    @selectedApplication.CoverLetter

                </p>

            </div>

            <div class="row mb-3">

                <div class="col-md-6">

                    <h6 class="fw-bold">
                        Ngân sách đề xuất
                    </h6>

                    <p class="fw-bold text-success">

                        @JobUi.Money(selectedApplication.ProposedBudget)

                    </p>

                </div>

                <div class="col-md-6">

                    <h6 class="fw-bold">
                        Ngày gửi đơn
                    </h6>

                    <p>

                        @selectedApplication.CreatedAt
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy HH:mm")

                    </p>

                </div>

            </div>

            @if (selectedApplication.Status == "Pending")
            {
                <div class="alert alert-warning">

                    <i class="bi bi-hourglass-split me-2"></i>

                    Đơn ứng tuyển đang chờ nhà tuyển dụng xem xét.

                </div>
            }
            else if (selectedApplication.Status == "Accepted")
            {
                <div class="alert alert-success">

                    <i class="bi bi-check-circle me-2"></i>

                    Đơn ứng tuyển của bạn đã được nhà tuyển dụng chấp nhận.

                    Hãy theo dõi các bước tiếp theo của quá trình tuyển dụng.

                </div>
            }
            else if (selectedApplication.Status == "Rejected")
            {
                <div class="alert alert-danger">

                    <i class="bi bi-x-circle me-2"></i>

                    <strong>
                        Đơn ứng tuyển đã bị từ chối.
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(
                        selectedApplication.RejectionReason))
                    {
                        <div class="mt-2">

                            Lý do:

                            @selectedApplication.RejectionReason

                        </div>
                    }

                </div>
            }

            <div class="small text-muted">

                Mã đơn ứng tuyển:

                @selectedApplication.Id

            </div>

        </div>

    </div>
}

@code {

    private List<ApplicationItem> applications = new();

    private string keyword = "";

    private string statusFilter = "";

    private bool loading;

    private string? error;

    private ApplicationItem? selectedApplication;

    private IEnumerable<ApplicationItem> FilteredApplications =>
        applications.Where(application =>

            (string.IsNullOrWhiteSpace(keyword) ||

             application.JobTitle.Contains(
                 keyword,
                 StringComparison.OrdinalIgnoreCase)) &&

            (string.IsNullOrWhiteSpace(statusFilter) ||

             application.Status == statusFilter));

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;

        try
        {
            applications =
                await JobApi.GetMyApplicationsAsync();

            if (selectedApplication is not null)
            {
                var selectedId = selectedApplication.Id;

                selectedApplication = applications
                    .FirstOrDefault(x => x.Id == selectedId);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowDetails(ApplicationItem application)
    {
        selectedApplication = application;
    }

    private void CloseDetails()
    {
        selectedApplication = null;
    }

    private void GoToFindJobs()
    {
        Nav.NavigateTo("tim-viec");
    }
}