{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "JobPlatform",
    "Audience": "JobPlatformClients"
  },
  "RabbitMq": {
    "Host": "localhost"
  },
  "WalletReconciliation": {
    "IntervalSeconds": 300
  },
  "PaymentSimulator": {
    "Enabled": false
  }
}
