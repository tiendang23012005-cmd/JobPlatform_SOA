# Đặt mật khẩu SQL Server và khóa JWT riêng trong .env.
SA_PASSWORD=
JWT_KEY=
# Tùy chọn: gửi OTP bằng email thật (để trống thì OTP chỉ ghi vào log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Chỉ bật cổng nạp mô phỏng ở Development hoặc Test. Cấp khóa ngẫu nhiên tối thiểu 32 byte.
PAYMENT_ENVIRONMENT=Production
PAYMENT_SIMULATOR_ENABLED=false
PAYMENT_SIMULATOR_SIGNING_KEY=

INTERNAL_API_KEY=JobPlatform_Internal_2026_Nhan_Secret_Key_ChangeThis